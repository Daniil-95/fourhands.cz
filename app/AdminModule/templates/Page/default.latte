{block content}
    <div class="page-header">
        <div>
            <h2>{$pageTitle}</h2>
            <p class="muted">Upravte pevné sekce této stránky.</p>
        </div>
    </div>

    <section class="widget">
        <div class="widget-list">
            {foreach $sections as $section}
                <div class="widget-item">
                    <span class="widget-item-title">{$sectionLabels[$section->section_key] ?? $section->section_key}</span>
                    <span class="widget-item-meta">{$section->title}</span>
                    <a n:href="edit id => $section->id">Upravit</a>
                </div>
            {/foreach}
        </div>
    </section>
{/block}