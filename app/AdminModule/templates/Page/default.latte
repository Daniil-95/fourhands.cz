{block content}
    <div class="page-header">
        <div>
            <h2>{$pageTitle}</h2>
            <p class="muted">Upravte pevné sekce této stránky. Jazyk obsahu: {$adminContentLang === 'en' ? 'English' : 'Čeština'}.</p>
        </div>
    </div>

    <section class="widget" n:if="$hasHeroForm">
        <h3>Úvodní část stránky</h3>
        {control sectionForm}
    </section>

    <section class="widget" n:if="$sections">
        <h3>Sekce stránky</h3>
        <div class="widget-list">
            {foreach $sections as $section}
                <div class="widget-item">
                    <span class="widget-item-title">{$section->title ?: ($sectionLabels[$section->section_key] ?? $section->section_key)}</span>
                    <a class="btn-secondary" n:href="edit id => $section->id">Upravit</a>
                </div>
            {/foreach}
        </div>
    </section>
{/block}