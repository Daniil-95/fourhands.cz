{block content}
    <div class="page-header">
        <div>
            <h2>{$sectionTitle}</h2>
            <p class="muted">Stránka: {$pageTitle}</p>
        </div>
    </div>
    <p><a n:href="default lang => $adminContentLang" class="btn-back">&larr; Zpět ke stránkám</a></p>

    {if $currentImagePath}
        <div class="preview-box">
            <strong>Aktuální obrázek:</strong><br>
            <img src="{$basePath}/{$currentImagePath}" alt="Náhled" class="media-preview">
        </div>
    {/if}

    {control sectionForm}
{/block}

{block scripts}
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.3/tinymce.min.js"></script>
    <script>
        tinymce.init({
            selector: '#frm-sectionForm-content',
            language: 'cs',
            height: 400,
            plugins: 'link image lists code table media',
            toolbar: 'undo redo | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image | code',
            toolbar_mode: 'wrap',
            menubar: false,
            branding: false,
            promotion: false,
            statusbar: true,
            mobile: { height: 300, toolbar_mode: 'scrolling' }
        });
    </script>
{/block}