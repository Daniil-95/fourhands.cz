{block content}
    <div class="page-header">
        <div>
            <h2>{$sectionTitle}</h2>
            <p class="muted">Stránka: {$pageTitle} &middot; Jazyk: {$adminContentLang === 'en' ? 'English' : 'Čeština'}</p>
        </div>
    </div>
    <p n:if="$showBackLink ?? true"><a n:href="default page => $pageKey" class="btn-back">&larr; Zpět ke stránkám</a></p>

    <div class="{if $currentImagePath}section-editor-grid{/if}">
        <div>
            {control sectionForm}
        </div>

        <aside class="hero-image-panel" n:if="$currentImagePath">
            <h3>Aktuální obrázek</h3>
            <img src="{$basePath}/{$currentImagePath}" alt="Náhled" class="hero-image-preview">
        </aside>
    </div>
{/block}

{block scripts}
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.3/tinymce.min.js"></script>
    <script>
        tinymce.init({
            selector: '#frm-sectionForm-content',
            language: 'cs',
            height: 400,
            plugins: 'link image lists code table media',
            toolbar: 'undo redo | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image | code',
            toolbar_mode: 'wrap',
            menubar: false,
            branding: false,
            promotion: false,
            statusbar: true,
            mobile: { height: 300, toolbar_mode: 'scrolling' }
        });
    </script>
{/block}