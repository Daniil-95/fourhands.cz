{block content}
    <div class="page-header">
        <div>
            <h2>{if $activeTab === 'video'}Videogalerie{else}Fotogalerie{/if}</h2>
            <p class="muted">{if $activeTab === 'video'}Spravujte odkazy na videa a jejich náhledy.{else}Nahrávejte fotografie, nastavte pořadí a upravte jejich názvy.{/if}</p>
        </div>
    </div>

    <section class="media-section media-section--settings">
        <div class="media-section__head">
            <div>
                <h3>Texty stránky</h3>
                <p class="muted">Upravte titulek a podtitulek této galerie na webu.</p>
            </div>
        </div>
        {form mediaSectionForm class => 'media-section-form'}
            <div class="media-section-form__grid">
                <label>{label title /}{input title}</label>
                <label>{label subtitle /}{input subtitle}</label>
            </div>
            {input save class => 'btn'}
        {/form}
    </section>

    {if $activeTab !== 'video'}
    <section class="media-section">
        <div class="media-section__head">
            <div>
                <h3>Fotogalerie</h3>
                <p class="muted">Nahrávejte fotografie, nastavte pořadí a upravte jejich názvy.</p>
            </div>
            <a class="btn" n:href="edit type => 'photo'">Přidat fotografii</a>
        </div>
        <div class="media-grid">
            {foreach $photos as $item}
                <article class="media-card">
                    <div class="media-card__image-wrap">
                        {if $item->image_path}
                            <img src="{$basePath}/{$item->image_path}" alt="{$item->title}" class="media-card__image">
                        {else}
                            <div class="media-card__placeholder">Bez náhledu</div>
                        {/if}
                    </div>
                    <div class="media-card__body">
                        <h4>{$item->title}</h4>
                        <div class="media-meta">
                            <span><strong>Jazyk:</strong> {$item->lang}</span>
                            <span><strong>Pořadí:</strong> {$item->sort_order}</span>
                            <span><strong>Stav:</strong> {if $item->active}Aktivní{else}Neaktivní{/if}</span>
                        </div>
                        <div class="media-card__actions">
                            <a class="btn btn-secondary" n:href="edit id => $item->id">Upravit</a>
                            <form method="post" action="{link delete id => $item->id, type => 'photo'}" class="inline-delete-form" onsubmit="return confirm('Smazat toto médium?')">
                                <input type="hidden" name="_token" value="{$csrfToken}">
                                <button type="submit" class="btn-delete">Smazat</button>
                            </form>
                        </div>
                    </div>
                </article>
            {/foreach}
            {if !count($photos)}
                <p class="table-empty">Zatím nejsou přidány žádné fotografie.</p>
            {/if}
        </div>
    </section>
    {/if}

    {if $activeTab !== 'photo'}
    <section class="media-section">
        <div class="media-section__head">
            <div>
                <h3>Video galerie</h3>
                <p class="muted">Přidávejte odkazy na YouTube videa. Náhled se načte automaticky, pokud je URL správná.</p>
            </div>
            <a class="btn" n:href="edit type => 'video'">Přidat video odkaz</a>
        </div>
        <div class="media-grid media-grid--video">
            {foreach $videos as $item}
                <article class="media-card media-card--video">
                    <div class="media-card__image-wrap">
                        {var $preview = $item->youtube_thumb ?? ''}
                        {var $previewFallback = $item->youtube_thumb_fallback ?? ''}
                        {if !$preview && $item->image_path}
                            {var $preview = $basePath . '/' . $item->image_path}
                        {/if}
                        {if $preview}
                            <img src="{$preview}" alt="{$item->title}" class="media-card__image" onerror="this.onerror=null;this.src='{$previewFallback}'">
                        {else}
                            <div class="media-card__placeholder">YouTube náhled nenalezen</div>
                        {/if}
                    </div>
                    <div class="media-card__body">
                        <h4>{$item->title}</h4>
                        <div class="media-meta">
                            <span><strong>Jazyk:</strong> {$item->lang}</span>
                            <span><strong>Pořadí:</strong> {$item->sort_order}</span>
                            <span><strong>Stav:</strong> {if $item->active}Aktivní{else}Neaktivní{/if}</span>
                        </div>
                        <p class="media-url" title="{$item->url}">{$item->url|truncate:65}</p>
                        <div class="media-card__actions">
                            <a class="btn btn-secondary" n:href="edit id => $item->id">Upravit</a>
                            <form method="post" action="{link delete id => $item->id, type => 'video'}" class="inline-delete-form" onsubmit="return confirm('Smazat toto médium?')">
                                <input type="hidden" name="_token" value="{$csrfToken}">
                                <button type="submit" class="btn-delete">Smazat</button>
                            </form>
                        </div>
                    </div>
                </article>
            {/foreach}
            {if !count($videos)}
                <p class="table-empty">Zatím nejsou přidána žádná videa.</p>
            {/if}
        </div>
    </section>
    {/if}

{/block}
