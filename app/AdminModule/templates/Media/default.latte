{block content}
    <div class="page-header">
        <div>
            <h2>{if $activeTab === 'video'}Videogalerie{else}Fotogalerie{/if}</h2>
            <p class="muted">{if $activeTab === 'video'}Spravujte odkazy na videa a jejich náhledy.{else}Nahrávejte fotografie, nastavte pořadí a upravte jejich názvy.{/if}</p>
        </div>
    </div>

    <section class="media-section media-section--settings">
        <div class="media-section__head">
            <div>
                <h3>Texty stránky</h3>
                <p class="muted">Titulek se zobrazuje na hlavní straně i na vlastní stránce galerie. Podtitulek se zobrazuje pouze na vlastní stránce galerie. Nadtitulek (např. „Fotogalerie“/„Videogalerie“) je pevný text a nelze jej v administraci upravit.</p>
            </div>
        </div>
        {form mediaSectionForm class => 'media-section-form'}
            <div class="media-section-form__grid">
                <label>{label title /}{input title}</label>
                <label>{label subtitle /}{input subtitle}</label>
            </div>
            {input save class => 'btn'}
        {/form}
    </section>

    {if $activeTab !== 'video'}
    <section class="media-section">
        <div class="media-section__head">
            <div>
                <h3>Fotogalerie</h3>
                <p class="muted">Nahrávejte fotografie, nastavte pořadí a upravte jejich názvy.</p>
                <p class="muted media-reorder-note">Tip: Na počítači můžete pořadí měnit přetažením karty myší.</p>
            </div>
            <a class="btn" n:href="edit type => 'photo'">Přidat fotografii</a>
        </div>
        <div class="media-grid" data-reorder-grid data-reorder-type="photo" data-reorder-url="{link reorder type => 'photo'}" data-csrf-token="{$csrfToken}">
            {foreach $photos as $item}
                <article class="media-card" draggable="true" data-media-id="{$item->id}">
                    <div class="media-card__image-wrap">
                        {if $item->image_path}
                            <img src="{$basePath}/{$item->image_path}" alt="{$item->title}" class="media-card__image">
                        {else}
                            <div class="media-card__placeholder">Bez náhledu</div>
                        {/if}
                    </div>
                    <div class="media-card__body">
                        <div class="media-card__drag" title="Přetažením změňte pořadí" aria-hidden="true">&#x2630; Přetáhnout</div>
                        <h4>{$item->title}</h4>
                        <div class="media-meta">
                            <span><strong>Jazyk:</strong> {$item->lang}</span>
                            <span><strong>Pořadí:</strong> <span data-sort-order>{$item->sort_order}</span></span>
                            <span><strong>Stav:</strong> {if $item->active}Aktivní{else}Neaktivní{/if}</span>
                        </div>
                        <div class="media-card__actions">
                            <a class="btn btn-secondary" n:href="edit id => $item->id">Upravit</a>
                            <form method="post" action="{link delete id => $item->id, type => 'photo'}" class="inline-delete-form" onsubmit="return confirm('Smazat toto médium?')">
                                <input type="hidden" name="_token" value="{$csrfToken}">
                                <button type="submit" class="btn-delete">Smazat</button>
                            </form>
                        </div>
                    </div>
                </article>
            {/foreach}
            {if !count($photos)}
                <p class="table-empty">Zatím nejsou přidány žádné fotografie.</p>
            {/if}
        </div>
    </section>
    {/if}

    {if $activeTab !== 'photo'}
    <section class="media-section">
        <div class="media-section__head">
            <div>
                <h3>Video galerie</h3>
                <p class="muted">Přidávejte odkazy na YouTube videa. Náhled se načte automaticky, pokud je URL správná.</p>
                <p class="muted media-reorder-note">Tip: Na počítači můžete pořadí měnit přetažením karty myší.</p>
            </div>
            <a class="btn" n:href="edit type => 'video'">Přidat video odkaz</a>
        </div>
        <div class="media-grid media-grid--video" data-reorder-grid data-reorder-type="video" data-reorder-url="{link reorder type => 'video'}" data-csrf-token="{$csrfToken}">
            {foreach $videos as $item}
                <article class="media-card media-card--video" draggable="true" data-media-id="{$item->id}">
                    <div class="media-card__image-wrap">
                        {var $preview = $item->youtube_thumb ?? ''}
                        {var $previewFallback = $item->youtube_thumb_fallback ?? ''}
                        {if !$preview && $item->image_path}
                            {var $preview = $basePath . '/' . $item->image_path}
                        {/if}
                        {if $preview}
                            <img src="{$preview}" alt="{$item->title}" class="media-card__image" onerror="this.onerror=null;this.src='{$previewFallback}'">
                        {else}
                            <div class="media-card__placeholder">YouTube náhled nenalezen</div>
                        {/if}
                    </div>
                    <div class="media-card__body">
                        <div class="media-card__drag" title="Přetažením změňte pořadí" aria-hidden="true">&#x2630; Přetáhnout</div>
                        <h4>{$item->title}</h4>
                        <div class="media-meta">
                            <span><strong>Jazyk:</strong> {$item->lang}</span>
                            <span><strong>Pořadí:</strong> <span data-sort-order>{$item->sort_order}</span></span>
                            <span><strong>Stav:</strong> {if $item->active}Aktivní{else}Neaktivní{/if}</span>
                        </div>
                        <p class="media-url" title="{$item->url}">{$item->url|truncate:65}</p>
                        <div class="media-card__actions">
                            <a class="btn btn-secondary" n:href="edit id => $item->id">Upravit</a>
                            <form method="post" action="{link delete id => $item->id, type => 'video'}" class="inline-delete-form" onsubmit="return confirm('Smazat toto médium?')">
                                <input type="hidden" name="_token" value="{$csrfToken}">
                                <button type="submit" class="btn-delete">Smazat</button>
                            </form>
                        </div>
                    </div>
                </article>
            {/foreach}
            {if !count($videos)}
                <p class="table-empty">Zatím nejsou přidána žádná videa.</p>
            {/if}
        </div>
    </section>
    {/if}

{/block}

{block scripts}
    <script>
        (function () {
            'use strict';

            var desktopPointer = window.matchMedia('(pointer: fine)').matches;
            if (!desktopPointer) {
                return;
            }

            var grids = document.querySelectorAll('[data-reorder-grid]');
            grids.forEach(function (grid) {
                var reorderUrl = grid.getAttribute('data-reorder-url');
                var csrfToken = grid.getAttribute('data-csrf-token');
                if (!reorderUrl || !csrfToken) {
                    return;
                }

                var draggingCard = null;
                var pendingSave = false;

                var getCards = function () {
                    return Array.prototype.slice.call(grid.querySelectorAll('[data-media-id]'));
                };

                var refreshSortOrderLabels = function (sortMap) {
                    getCards().forEach(function (card) {
                        var id = card.getAttribute('data-media-id');
                        var label = card.querySelector('[data-sort-order]');
                        if (!id || !label || !sortMap[id]) {
                            return;
                        }
                        label.textContent = String(sortMap[id]);
                    });
                };

                var saveOrder = function () {
                    if (pendingSave) {
                        return;
                    }

                    var ids = getCards().map(function (card) {
                        return card.getAttribute('data-media-id') || '';
                    }).filter(function (id) {
                        return id !== '';
                    });

                    if (ids.length === 0) {
                        return;
                    }

                    pendingSave = true;
                    grid.classList.add('is-saving-order');

                    var payload = new URLSearchParams();
                    payload.set('_token', csrfToken);
                    payload.set('ids', ids.join(','));

                    fetch(reorderUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: payload.toString()
                    }).then(function (response) {
                        return response.json();
                    }).then(function (result) {
                        if (!result || result.ok !== true) {
                            throw new Error(result && result.message ? result.message : 'Pořadí se nepodařilo uložit.');
                        }
                        if (result.sortMap) {
                            refreshSortOrderLabels(result.sortMap);
                        }
                    }).catch(function (error) {
                        alert(error && error.message ? error.message : 'Pořadí se nepodařilo uložit. Obnovte stránku.');
                        window.location.reload();
                    }).finally(function () {
                        pendingSave = false;
                        grid.classList.remove('is-saving-order');
                    });
                };

                getCards().forEach(function (card) {
                    card.addEventListener('dragstart', function () {
                        draggingCard = card;
                        card.classList.add('is-dragging');
                    });

                    card.addEventListener('dragend', function () {
                        card.classList.remove('is-dragging');
                        if (!draggingCard) {
                            return;
                        }
                        draggingCard = null;
                        saveOrder();
                    });
                });

                grid.addEventListener('dragover', function (event) {
                    if (!draggingCard) {
                        return;
                    }
                    event.preventDefault();
                    var targetCard = event.target.closest('[data-media-id]');
                    if (!targetCard || targetCard === draggingCard || targetCard.parentNode !== grid) {
                        return;
                    }

                    var rectangle = targetCard.getBoundingClientRect();
                    var placeAfter = event.clientY > rectangle.top + rectangle.height / 2;
                    grid.insertBefore(draggingCard, placeAfter ? targetCard.nextSibling : targetCard);
                });
            });
        })();
    </script>
{/block}
