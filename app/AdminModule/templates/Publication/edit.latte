{block title}{if $editingId}Upravit publikaci{else}Nová publikace{/if}{/block}

{block content}
    <div class="page-header">
        <div>
            <h2>{if $editingId}Upravit publikaci{else}Nová publikace{/if}</h2>
            <p class="muted">Přidejte článek, publikaci nebo zmínku. Zdroj označuje časopis, web nebo pořad, kde se o vás píše.</p>
        </div>
    </div>

    <p><a n:href="default lang => $adminContentLang" class="btn-back">&larr; Zpět na přehled</a></p>

    {control publicationForm}
{/block}
