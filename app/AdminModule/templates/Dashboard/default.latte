{block content}
    <div class="page-header">
        <div>
            <h2>Rychlý přístup</h2>
            <p class="muted">Vyberte stránku, kterou chcete upravit.</p>
        </div>
    </div>

    <div class="dashboard-cards dashboard-cards--pages">
        {foreach $pages as $pageKey => $pageTitle}
            <article class="card page-card">
                <h3>{$pageTitle}</h3>
                <p>{switch $pageKey}{case 'homepage'}Hero hlavní stránky.{case 'about'}Hero a hlavní obsah stránky O nás.{case 'artists'}Hero a profily umělkyň.{case 'repertoire'}Hero a obsah koncertního programu.{case 'from_stage'}Hero a obsah sekce Z pódia.{/switch}</p>
                {if $pageKey === 'homepage'}
                    <a class="card-link" n:href=":Admin:Page:hero">Otevřít sekci</a>
                {else}
                    <a class="card-link" n:href=":Admin:Page:default page => $pageKey">Otevřít sekce</a>
                {/if}
            </article>
        {/foreach}
    </div>

    <div class="page-header page-header--compact">
        <div>
            <h2>Data a nastavení</h2>
            <p class="muted">Rychlý přístup k ostatním částem administrace.</p>
        </div>
    </div>

    <div class="dashboard-cards dashboard-cards--tools">
        {foreach $quickActions as $action}
            <article class="card page-card page-card--tool">
                <h3>{$action['title']}</h3>
                <p>{$action['description']}</p>
                <a class="card-link" n:href="$action['href'], ...($action['params'] ?? [])">Otevřít sekci</a>
            </article>
        {/foreach}
    </div>
{/block}
