{block content}
    <div class="page-header">
        <div>
            <h2>Rychlý přístup</h2>
            <p class="muted">Vyberte stránku, kterou chcete upravit.</p>
        </div>
    </div>

    <div class="dashboard-cards dashboard-cards--pages">
        {foreach $pages as $pageKey => $pageTitle}
            <article class="card page-card">
                <h3>{$pageTitle}</h3>
                <p>{switch $pageKey}{case 'homepage'}Hero, programy, videa, galerie a kontakt.{case 'about'}Hero a hlavní obsah stránky O nás.{case 'artists'}Hero a profily umělkyň.{case 'repertoire'}Hero a obsah repertoáru.{case 'gallery'}Hero a nastavení galerie.{case 'videos'}Hero a nastavení videí.{case 'events'}Hero a nastavení událostí.{case 'from_stage'}Hero a obsah sekce Z pódia.{/switch}</p>
                <a class="card-link" n:href=":Admin:Page:default page => $pageKey">Otevřít sekce</a>
            </article>
        {/foreach}
    </div>
{/block}
