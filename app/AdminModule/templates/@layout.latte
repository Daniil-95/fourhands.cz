<!DOCTYPE html>
<html lang="cs">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{ifset title}{include title|stripHtml} | {/ifset}Fourhands Administrace</title>
        <link rel="stylesheet" href="{$basePath}/css/admin.css">
    </head>
    <body>
        <a href="#main-content" class="skip-link">Přeskočit na obsah</a>

        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Otevřít menu" aria-expanded="false" type="button">
            &#9776;
        </button>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="admin-shell">
            <aside class="sidebar" id="sidebar" role="navigation" aria-label="Hlavní navigace">
                <div class="sidebar-header">
                    <h1>Fourhands</h1>
                    <span class="sidebar-subtitle">Administrace</span>
                </div>
                <nav>
                    <span class="nav-section">Obsah</span>

                    <a n:href=":Admin:Dashboard:default" class="{if $presenter->getName() === 'Admin:Dashboard'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Přehled
                    </a>

                    <a n:href=":Admin:Page:hero" class="{if $presenter->getName() === 'Admin:Page' && $presenter->getAction() === 'hero'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Úvodní sekce
                    </a>

                    <a n:href=":Admin:Page:section page => 'about', section => 'content'" class="{if $presenter->getName() === 'Admin:Page' && $presenter->getParameter('page') === 'about'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> O nás
                    </a>

                    <a n:href=":Admin:Page:default page => 'artists'" class="{if $presenter->getName() === 'Admin:Page' && $presenter->getParameter('page') === 'artists'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Umělkyně
                    </a>

                    <a n:href=":Admin:Page:default page => 'repertoire'" class="{if $presenter->getName() === 'Admin:Page' && $presenter->getParameter('page') === 'repertoire'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Repertoár
                    </a>

                    <span class="nav-section">Data</span>

                    <a n:href=":Admin:Event:default" class="{if $presenter->getName() === 'Admin:Event'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Události
                    </a>

                    <a n:href=":Admin:Publication:default" class="{if $presenter->getName() === 'Admin:Publication'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Z pódia
                    </a>

                    <a n:href=":Admin:Media:default type => 'photo'" class="{if $presenter->getName() === 'Admin:Media' && $presenter->getParameter('type') === 'photo'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Fotogalerie
                    </a>

                    <a n:href=":Admin:Media:default type => 'video'" class="{if $presenter->getName() === 'Admin:Media' && $presenter->getParameter('type') === 'video'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Videogalerie
                    </a>

                    <span class="nav-section">Nastavení</span>

                    <a n:href=":Admin:Navigation:default" class="{if $presenter->getName() === 'Admin:Navigation'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Menu
                    </a>

                    <a n:href=":Admin:Setting:default" class="{if $presenter->getName() === 'Admin:Setting'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Nastavení webu
                    </a>

                    <a n:href=":Admin:Setting:seo" class="{if $presenter->getName() === 'Admin:Setting' && $presenter->getAction() === 'seo'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> SEO
                    </a>

                    <a n:href=":Admin:Inquiry:default" class="{if $presenter->getName() === 'Admin:Inquiry'}active{/if}">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Zprávy
                    </a>

                </nav>

                <div class="sidebar-footer">
                    <a n:href=":Front:Homepage:default" target="_blank">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Otevřít web
                    </a>

                    <a n:href=":Admin:Sign:out">
                        <span class="nav-icon" aria-hidden="true">&#9632;</span> Odhlásit se
                    </a>
                </div>
            </aside>

            <main class="main" id="main-content">
                <div class="flash-container">
                    <div n:foreach="$flashes as $flash" class="flash {$flash->type}" role="alert">
                        {$flash->message}
                    </div>
                </div>

                <div class="admin-content">
                    <div class="admin-lang-switch" n:if="$presenter->getAction() !== 'default' || $presenter->getName() !== 'Admin:Dashboard'">
                        <span>Jazyk obsahu:</span>
                        <a n:href="this lang => 'cs'" class="{if $adminContentLang === 'cs'}is-active{/if}">Čeština</a>
                        <a n:href="this lang => 'en'" class="{if $adminContentLang === 'en'}is-active{/if}">English</a>
                    </div>
                    {include content}
                </div>
            </main>
        </div>

        <script>
            (function() {
                'use strict';

                var toggle = document.getElementById('sidebarToggle');
                var sidebar = document.getElementById('sidebar');
                var backdrop = document.getElementById('sidebarBackdrop');

                if (!toggle || !sidebar) return;

                function openMenu() {
                    sidebar.classList.add('open');
                    backdrop.classList.add('visible');
                    toggle.setAttribute('aria-expanded', 'true');
                    toggle.setAttribute('aria-label', 'Zavřít menu');
                    toggle.innerHTML = '&#10005;';
                    document.body.classList.add('sidebar-open');
                    if (toggle.focus) toggle.focus();
                }

                function closeMenu() {
                    sidebar.classList.remove('open');
                    backdrop.classList.remove('visible');
                    toggle.setAttribute('aria-expanded', 'false');
                    toggle.setAttribute('aria-label', 'Otevřít menu');
                    toggle.innerHTML = '&#9776;';
                    document.body.classList.remove('sidebar-open');
                }

                toggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (sidebar.classList.contains('open')) {
                        closeMenu();
                    } else {
                        openMenu();
                    }
                });

                backdrop.addEventListener('click', closeMenu);

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && sidebar.classList.contains('open')) {
                        closeMenu();
                        if (toggle.focus) toggle.focus();
                    }
                });

                // Close sidebar on link click (mobile)
                sidebar.querySelectorAll('a').forEach(function(link) {
                    link.addEventListener('click', function() {
                        if (window.innerWidth <= 920) {
                            closeMenu();
                        }
                    });
                });
            })();
        </script>

        {ifset #scripts}
            {include #scripts}
        {/ifset}
    </body>
</html>
