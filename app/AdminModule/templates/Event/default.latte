{block content}
    <div class="page-header">
        <h2>Události</h2>
    </div>
    <section class="media-section media-section--settings" n:if="$pageHero">
        <div class="media-section__head">
            <div>
                <h3>Úvodní část stránky</h3>
            </div>
        </div>
        {form eventPageForm class => 'media-section-form'}
            <div class="media-section-form__grid">
                <label>{label title /}{input title}</label>
                <label>{label subtitle /}{input subtitle}</label>
            </div>
            {input save class => 'btn'}
        {/form}
    </section>
    <section class="media-section">
        <div class="media-section__head">
            <div>
                <h3>Události</h3>
            </div>
            <a class="btn" n:href="edit">Přidat událost</a>
        </div>
        <div class="table-container">
        <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Foto</th>
            <th>Jazyk</th>
            <th>Datum</th>
            <th>Název</th>
            <th>Stav</th>
            <th>Akce</th>
        </tr>
        </thead>
        <tbody>
        <tr n:foreach="$items as $item">
            <td data-label="ID">{$item->id}</td>
            <td data-label="Foto">
                {if $item->image_path}
                    <img src="{$basePath}/{$item->image_path}" alt="" class="media-thumb">
                {else}
                    <span class="muted">bez fota</span>
                {/if}
            </td>
            <td data-label="Jazyk">{$item->lang}</td>
            <td data-label="Datum">{$item->publish_date|date:'j. n. Y'}</td>
            <td data-label="Název">{$item->title|truncate:70}</td>
            <td data-label="Stav">{if $item->active}<span class="badge badge-active">Aktivní</span>{else}<span class="badge badge-inactive">Neaktivní</span>{/if}</td>
            <td data-label="Akce" class="actions-cell">
                <a n:href="edit id => $item->id">Upravit</a>
                <form method="post" action="{link delete id => $item->id}" class="inline-delete-form" onsubmit="return confirm('Smazat tuto událost?')">
                    <input type="hidden" name="_token" value="{$csrfToken}">
                    <button type="submit" class="btn-delete">Smazat</button>
                </form>
            </td>
        </tr>
        </tbody>
        </table>
        </div>
    </section>
{/block}
