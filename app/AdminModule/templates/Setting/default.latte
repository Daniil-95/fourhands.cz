{block content}
    <div class="page-header">
        <div>
            <h2>Nastavení webu</h2>
            <p class="muted">Uspořádané nastavení webu pro jazyk: {$adminContentLang === 'en' ? 'English' : 'Čeština'}.</p>
        </div>
        <a class="btn" n:href="edit">Přidat nastavení</a>
    </div>

    <div class="settings-groups">
        <section n:foreach="$groups as $groupName => $groupItems" n:if="$groupItems" class="settings-group settings-group-{$groupName}">
            <div class="settings-group-header">
                <div>
                    <span class="settings-group-kicker">Nastavení webu</span>
                    <h3>{$groupLabels[$groupName]}</h3>
                    <p>{$groupDescriptions[$groupName]}</p>
                </div>
                <span class="badge badge-group badge-group-{$groupName}">{count($groupItems)} položek</span>
            </div>

            <div class="settings-list">
                <article n:foreach="$groupItems as $item" class="setting-item">
                    <div class="setting-item-copy">
                        <h4>{$item->label}</h4>
                        <code>{$item->key_name}</code>
                    </div>
                    <p class="setting-item-value">{$item->value_text !== '' ? $item->value_text : 'Není vyplněno'}</p>
                    <div class="setting-item-actions">
                        <a n:href="edit id => $item->id">Upravit</a>
                        <form method="post" action="{link delete id => $item->id}" class="inline-delete-form" onsubmit="return confirm('Smazat toto nastavení?')">
                            <input type="hidden" name="_token" value="{$csrfToken}">
                            <button type="submit" class="btn-delete">Smazat</button>
                        </form>
                    </div>
                </article>
            </div>
        </section>
    </div>
{/block}
