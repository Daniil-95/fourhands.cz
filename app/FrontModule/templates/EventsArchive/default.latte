{block title}{_'Event archive'}{/block}
{block content}
    {var $hero = $pageSections['events']['hero'] ?? null}
    <section class="page-hero">
        <div class="container">
            <p class="eyebrow eyebrow--light">{$locale === 'cs' ? 'Archiv událostí' : 'Event archive'}</p>
            <h1>{$hero?->title ?: 'Archiv událostí'}</h1>
            <p>{$hero?->subtitle ?: 'Minulá vystoupení a události.'}</p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            {if $events['past']}
                <div class="row gy-3">
                    <div class="col-md-6" n:foreach="$events['past'] as $event">
                        <article class="event-card event-card--archive">
                            <time datetime="{$event['event_date']->format('Y-m-d')}">{$event['event_date']|date:'j. n. Y'}</time>
                            <small>{$event['event_date']|date:'F'}</small>
                            <h3>{$event['description']}</h3>
                        </article>
                    </div>
                </div>
            {else}
                <p>{_'No past events available yet.'}</p>
            {/if}
        </div>
    </section>
{/block}
