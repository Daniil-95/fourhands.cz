{block title}{_'Events'}{/block}
{block content}
    {var $hero = $pageSections['events']['hero'] ?? null}
    <section class="page-hero">
        <div class="container">
            <p class="eyebrow eyebrow--light">{$locale === 'cs' ? 'Koncerty a události' : 'Concerts and events'}</p>
            <h1>{$hero?->title ?: ($locale === 'cs' ? 'Události' : 'Events')}</h1>
            <p>{$hero?->subtitle ?: ($locale === 'cs' ? 'Kde nás můžete slyšet.' : 'Where you can hear us.')}</p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            {if $events['upcoming']}
                <div class="section-heading">
                    <p class="eyebrow">{_'Upcoming performances'}</p>
                    <h2>{_'Events'}</h2>
                </div>
                <div class="events-grid">
                    <article class="event-tile reveal" n:foreach="$events['upcoming'] as $event">
                        <div class="event-tile__media" style="background-image:url('{$basePath}/{$event['image_path'] ?: ($hero?->image_path ?: 'images/story.jpg')}')">
                            <div class="event-tile__date">
                                <strong>{$event['event_date']|date:'d'}</strong>
                                <span>{$event['event_date']|date:'M Y'}</span>
                            </div>
                        </div>
                        <div class="event-tile__body">
                            <h3>{$event['description']}</h3>
                        </div>
                    </article>
                </div>
            {/if}

            {if $events['past']}
                <div class="section-heading section-heading--archive">
                    <p class="eyebrow">{_'Event archive'}</p>
                    <h2>{_'Past events'}</h2>
                </div>
                <div class="events-list">
                    <article class="event-row reveal" n:foreach="$events['past'] as $event">
                        <div class="event-row__media" style="background-image:url('{$basePath}/{$event['image_path'] ?: ($hero?->image_path ?: 'images/story.jpg')}')"></div>
                        <div class="event-row__body">
                            <time datetime="{$event['event_date']->format('Y-m-d')}">{$event['event_date']|date:'j. n. Y'}</time>
                            <h3>{$event['description']}</h3>
                        </div>
                    </article>
                </div>
            {else}
                <p>{_'No past events available yet.'}</p>
            {/if}
        </div>
    </section>
{/block}
