{var $hero = $pageSections['homepage']['hero'] ?? null}
{var $videosSection = $pageSections['homepage']['videos'] ?? null}
{var $gallerySection = $pageSections['homepage']['gallery'] ?? null}
{var $contactSection = $pageSections['homepage']['contact'] ?? null}
{var $heroImage = $hero?->image_path ? $basePath . '/' . $hero->image_path : $basePath . '/images/story.jpg'}
{var $heroHeading = $hero?->title ?: 'FOURHANDS'}
{var $heroLead = $hero?->subtitle ?: 'Klavírní duo pro výjimečné okamžiky vašeho života.'}
{var $heroCta = $hero?->button_text ?: 'Kontakt'}
{var $heroScroll = $hero?->content ?: 'Objevte nás'}
{var $contactPhone = $siteSettings['phone'] ?: '+420 777 123 456'}
{var $contactEmail = $siteSettings['email'] ?: 'info@fourhands.cz'}
{var $contactAddress = $siteSettings['address'] ?: 'Praha, Česká republika'}
{var $contactImage = $contactSection?->image_path ? $basePath . '/' . $contactSection->image_path : $heroImage}

{block title}{_'Piano duo for exceptional moments'}{/block}

{block head}
    <link rel="preload" as="image" href="{$heroImage}" fetchpriority="high">
{/block}

{block content}
    <section class="hero" id="uvod" style="--hero-image:url('{$heroImage}');--hero-position:center 30%">
        <div class="container hero__content reveal">
            <p class="eyebrow eyebrow--light">{_'Piano Duo'}</p>
            <h1>{$heroHeading}</h1>
            <p class="hero__lead">{$heroLead}</p>
            <a class="button" href="{$basePath}{$hero?->button_url ?: '#kontakt'}">{$heroCta} <span>→</span></a>
        </div>
        <a class="hero__scroll" href="#videa">{$heroScroll} <span>↓</span></a>
    </section>

    <section class="section events-preview" id="udalosti">
        <div class="container">
            <div class="section-heading section-heading--split reveal">
                <div>
                    <p class="eyebrow">{_'Upcoming performances'}</p>
                    <h2>{if $locale === 'cs'}Kde nás můžete slyšet{else}Where you can hear us{/if}</h2>
                </div>
                <a class="button button--outline button--outline-light" n:href=":Front:EventsArchive:default locale => $locale">{_'See all events'} <span>→</span></a>
            </div>

            {if $upcomingEvents}
                <div class="events-preview__grid">
                    <article class="event-card event-card--featured reveal" n:foreach="$upcomingEvents as $eventKey => $event">
                        {var $eventImage = $photos[$eventKey]['image_path'] ?? $hero?->image_path ?? 'images/story.jpg'}
                        <div class="event-card__visual" style="background-image: url('{$basePath}/{$eventImage}')"></div>
                        <div class="event-card__body">
                            <time datetime="{$event['event_date']->format('Y-m-d')}">
                                <strong>{$event['event_date']|date:'d'}</strong>
                                <span>{$event['event_date']|date:'M Y'}</span>
                            </time>
                            <h3>{$event['description']}</h3>
                            <a n:href=":Front:EventsArchive:default locale => $locale">{_'Read more'} <span>→</span></a>
                        </div>
                    </article>
                </div>
            {else}
                <p class="events-preview__empty">{_'No upcoming events available yet.'}</p>
            {/if}
        </div>
    </section>

    <section class="section videos" id="videa">
        <div class="container">
            <div class="section-heading reveal"><p class="eyebrow">{$videosSection?->subtitle ?: 'Video prezentace'}</p>
                <h2>{$videosSection?->title ?: 'Poslouchejte nás'}</h2></div>
            <div class="slider-shell reveal">
                <div class="swiper video-swiper">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide" n:foreach="$videos as $video">
                            <a class="video-card" href="{$video['url']}" target="_blank" rel="noopener">
                                <img src="{$basePath}/{$video['image_path'] ?: 'images/kids1-thumb.jpg'}" width="640" height="427" alt="{$video['title']}" loading="lazy">
                                <span class="video-card__play">▶</span><strong>{$video['title']}</strong>
                            </a>
                        </div>
                    </div>
                </div>
                <button class="slider-arrow slider-arrow--prev video-prev" aria-label="{_'Previous video'}">←</button>
                <button class="slider-arrow slider-arrow--next video-next" aria-label="{_'Next video'}">→</button>
            </div>
            <div class="section-action">
                <a class="button button--outline button--outline-light" href="{$basePath}{$videosSection?->button_url ?: '/videa'}">{$videosSection?->button_text ?: 'Zobrazit všechna videa'}<span>→</span></a>
            </div>
        </div>
    </section>

    <section class="section section--light" id="galerie">
        <div class="container-fluid">
            <div class="section-heading reveal">
                <p class="eyebrow">{$gallerySection?->subtitle ?: 'Fotogalerie'}</p>
                <h2>{$gallerySection?->title ?: 'Momenty v obrazech'}</h2>
            </div>
            {if $photos}
                <div class="homepage-gallery reveal">
                    <div class="swiper homepage-gallery-swiper">
                        <div class="swiper-wrapper">
                            {foreach $photos as $photo}
                                <div class="swiper-slide">
                                    <a href="{$basePath}/{$photo['image_path']}" data-fancybox="homepage-gallery" data-caption="{$photo['title'] ?: 'Fourhands'}">
                                        <img src="{$basePath}/{$photo['image_path']}" alt="{$photo['title'] ?: 'Fourhands'}" loading="lazy">
                                    </a>
                                </div>
                            {/foreach}
                        </div>
                    </div>
                </div>
                <div class="section-action">
                    <a class="button button--outline" href="{$basePath}{$gallerySection?->button_url ?: '/galerie'}">{$gallerySection?->button_text ?: 'Zobrazit celou galerii'}<span>→</span></a>
                </div>
            {/if}
        </div>
    </section>

    <section class="contact" id="kontakt">
        <div class="container-fluid">
            <div class="row g-0">
                <div class="col-lg-5 contact__visual" style="background-image:url('{$contactImage}')"></div>
                <div class="col-lg-7 contact__content reveal">
                    <p class="eyebrow">Kontakt</p>
                    <h2>{$contactSection?->title ?: 'Plánujete akci?'}{if $contactSection?->subtitle}<br>{$contactSection->subtitle}{/if}</h2>
                    <div class="contact__details">
                        <a href="tel:+420777123456">{$contactPhone}</a>
                        <a href="mailto:{$contactEmail}">{$contactEmail}</a>
                        <span>{$contactAddress}</span>
                    </div>

                    {foreach $flashes as $flash}
                        <div class="flash {$flash->type}">{$flash->message}</div>
                    {/foreach}

                    {form inquiryForm class => 'inquiry-form'}
                        <div class="form-row">
                            <label>{label name /}{input name}</label><label>{label email /}{input email}</label></div>
                        <label>{label message /}{input message}</label>{input send class => 'button'}
                    {/form}
                </div>
            </div>
        </div>
    </section>
{/block}
