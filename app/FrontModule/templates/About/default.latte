{block title}{_'About us'}{/block}
{block content}
    {var $contentSection = $pageSections['about']['content'] ?? null}
    {var $aboutImage = $contentSection?->image_path}
    <section class="page-hero">
        <div class="container">
            <p class="eyebrow eyebrow--light">{$locale === 'cs' ? 'O nás' : 'About us'}</p>
            <h1>{$contentSection?->title ?: ($locale === 'cs' ? 'Čtyři ruce. Jeden hudební hlas.' : 'Four hands. One musical voice.')}</h1>
            <p>{$contentSection?->subtitle ?: ($locale === 'cs' ? 'Pražské klavírní duo pro čtyři ruce a dva klavíry.' : 'A Prague-based piano duo exploring the repertoire for four hands and two pianos.')}</p>
        </div>
    </section>

    <section class="section">
        <div class="container about-story reveal reveal--left {if !$aboutImage}about-story--no-image{/if}">
            <div class="about-story__media" n:if="$aboutImage">
                <img src="{$basePath}/{$optimizedImage($aboutImage, 1200)}" srcset="{$basePath}/{$optimizedImage($aboutImage, 480)} 480w, {$basePath}/{$optimizedImage($aboutImage, 1200)} 1200w" sizes="(max-width: 600px) 92vw, 50vw" alt="{$contentSection?->title}" loading="lazy">
            </div>
            <div class="rich-text about-story__text">
                {$contentSection?->content ?? '<p>Vítejte v Fourhands.</p>'|noescape}
            </div>
        </div>
    </section>
{/block}
