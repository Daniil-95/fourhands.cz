{block title}{_'About us'}{/block}
{block content}
    {var $hero = $pageSections['about']['hero'] ?? null}
    {var $contentSection = $pageSections['about']['content'] ?? null}
    <section class="page-hero">
        <div class="container">
            <p class="eyebrow eyebrow--light">O nás</p>
            <h1>{$hero?->title ?: 'Four hands. One musical voice.'}</h1>
            <p>{$hero?->subtitle ?: 'A Prague-based piano duo exploring the repertoire for four hands and two pianos.'}</p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="rich-text">
                {$contentSection?->content ?? '<p>Vítejte v Fourhands.</p>'|noescape}
            </div>
        </div>
    </section>
{/block}
