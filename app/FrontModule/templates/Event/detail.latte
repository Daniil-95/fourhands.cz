{block title}{$event->title}{/block}
{block content}
    <section class="page-hero">
        <div class="container">
            <p class="eyebrow eyebrow--light">{$locale === 'cs' ? 'Událost' : 'Event'}</p>
            <h1>{$event->title}</h1>
            <p>{$event->publish_date|date:'j. n. Y'}</p>
        </div>
    </section>

    <section class="section event-detail">
        <div class="container">
            <a class="button button--outline" n:href=":Front:EventsArchive:default locale => $locale">&larr; {_'Back to events'}</a>
            {if $event->image_path}
                <img class="event-detail__image" src="{$basePath}/{$event->image_path}" alt="{$event->title}">
            {/if}
            <div class="event-detail__content">
                {if $event->description}
                    <div class="event-detail__description">{$event->description}</div>
                {/if}
            </div>
        </div>
    </section>
{/block}