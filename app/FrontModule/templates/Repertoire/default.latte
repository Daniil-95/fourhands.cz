{block title}{_'Repertoire'}{/block}
{block content}
    {var $hero = $pageSections['repertoire']['hero'] ?? null}
    {var $contentSection = $pageSections['repertoire']['content'] ?? null}
    <section class="page-hero">
        <div class="container">
            <p class="eyebrow eyebrow--light">{$locale === 'cs' ? 'Repertoár' : 'Repertoire'}</p>
            <h1>{$hero?->title ?: 'Repertoár'}</h1>
            <p>{$hero?->subtitle ?: 'Hudba pro výjimečné okamžiky.'}</p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="rich-text">
                {$contentSection?->content ?? '<p>Repertoár bude doplněn v administraci.</p>'|noescape}
            </div>
        </div>
    </section>
{/block}
