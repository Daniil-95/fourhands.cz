{block title}{_'Videos'}{/block}
{block content}
    {var $hero = $pageSections['videos']['hero'] ?? null}
    <section class="page-hero">
        <div class="container"><p class="eyebrow eyebrow--light">{_'Video gallery'}</p>
            <h1>{$hero?->title ?: ($locale === 'cs' ? 'Poslouchejte Fourhands' : 'Listen to Fourhands')}</h1>
            <p>{$hero?->subtitle ?: ($locale === 'cs' ? 'Výběr koncertních vystoupení a hudebních ukázek.' : 'Selection of concert performances and music samples.')}</p></div>
    </section>
    <section class="section">
        <div class="container">
            <div class="video-grid">
                <a class="video-card reveal" href="{$video['url']}" target="_blank" rel="noopener" n:foreach="$videos as $video"><img src="{$basePath}/{$video['image_path'] ?: 'images/kids1-thumb.jpg'}" width="640" height="427" alt="{$video['title']}" loading="lazy"><span class="video-card__play">▶</span><strong>{$video['title']}</strong></a>
            </div>
        </div>
    </section>
{/block}
